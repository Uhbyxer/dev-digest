{
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm --version)",
      "Bash(pnpm exec vitest *)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(curl http://localhost*)",
